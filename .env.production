# Production config for the Cloudflare Pages deploy.
#
# OK to commit: these are publishable keys (pk_live_*) — designed to be
# exposed in client-side code, same threat model as Stripe's pk_live_* keys.
# They're baked into the JS bundle at build time and visible to any visitor
# via DevTools, so committing them adds zero exposure.
#
# The keys are domain-locked via `allowed_origins` on the worker side —
# copying these values gets an attacker nothing usable from any other domain.
#
# NEVER commit: sk_live_*, refresh tokens, DB credentials, webhook secrets.
# Those go via `wrangler secret put` only.

VITE_HEADLO_AUTH_ISSUER=https://auth.headlo.com
VITE_HEADLO_PUBLISHABLE_KEY=pk_live_bc4fd153cb752ffa1738561a86a9d3bb
VITE_HEADLO_API_URL=https://api.headlo.com
VITE_HEADLO_APP_URL=https://www.headlo.com

# Default cap_id for /cap-json and /view/cap-expert-widget when no cap_id is
# passed in the URL. Set per-env so prod points at a CAP that actually exists
# in the prod DB (dev's default `89ac1e46060d` may be a dev-only row).
VITE_HEADLO_DEFAULT_CAP_ID=ed91c6db23e3

# CMS anon key — powers /demo/cms-components (useHeadloClient + useCmsComponents).
# Same threat model as pk_live_* — domain-locked via allowed_origins on the worker.
VITE_HEADLO_ANON_KEY=pk_anon_70d2b28cbeee4270ac7c7899d78dfe86

# Clerk — for the /clerk/* side-by-side comparison routes AND for any prod
# endpoint that verifies Clerk JWTs (e.g. /v1/plugin/cap/:id → capGetHandler).
# Must be the pk_live_ from the PROD Clerk instance (clerk.headlo.com) so
# tokens minted here verify against prod worker's CLERK_JWKS_URI. Using the
# test pk here caused 401s on api.headlo.com because the JWT was signed by
# a Clerk instance the prod worker doesn't trust.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuaGVhZGxvLmNvbSQ
